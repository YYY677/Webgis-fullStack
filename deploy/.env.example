# 复制为 deploy/.env 后再填写。真实 .env 已被 deploy/.gitignore 忽略，禁止提交。

# PostgreSQL 初始数据库与用户。完整 GeoServer 目录初始使用 postgres，因此保持该用户名。
POSTGRES_DB=webgistest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# GeoServer 管理凭据：必须与 GeoServer.zip 中已有的管理员账号一致；后端和同步任务使用它。
# 不把该变量传给 GeoServer 容器，以免容器重启覆盖 ZIP security/ 中后来新增的用户/角色。
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver

# 此地址写入 GeoServer 的 GetCapabilities 返回结果。改为实际虚拟机 IP，例如：
# GEOSERVER_PROXY_BASE_URL=http://192.168.56.101/geoserver
GEOSERVER_PROXY_BASE_URL=http://localhost/geoserver

# Spring Boot JWT 签名密钥。请使用足够长的随机 Base64 字符串。
JWT_SECRET=replace-with-a-long-random-base64-secret

# Nginx 映射到宿主机的端口。80 被占用或非 root 用户运行时可改为 8088。
WEBGIS_HTTP_PORT=80

# Docker 前端构建路径；根路径部署使用 /。
VITE_DEPLOY_BASE=/

# 下列值会写入浏览器构建产物，只能填写可公开且已限制来源域名的 Token。
VITE_TIANDITU_KEY=
VITE_CESIUM_TOKEN=
