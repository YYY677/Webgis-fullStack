{
    "dataStore":  {
                      "name":  "asdad",
                      "type":  "PostGIS",
                      "enabled":  true,
                      "_default":  false,
                      "disableOnConnFailure":  false,
                      "workspace":  {
                                        "name":  "webgistest"
                                    },
                      "connectionParameters":  {
                                                   "entry":  [
                                                                 {
                                                                     "@key":  "schema",
                                                                     "$":  "public"
                                                                 },
                                                                 {
                                                                     "@key":  "database",
                                                                     "$":  "${GEOSERVER_DATASTORE_DATABASE}"
                                                                 },
                                                                 {
                                                                     "@key":  "port",
                                                                     "$":  "${GEOSERVER_DATASTORE_PORT}"
                                                                 },
                                                                 {
                                                                     "@key":  "passwd",
                                                                     "$":  "${GEOSERVER_DATASTORE_PASSWORD}"
                                                                 },
                                                                 {
                                                                     "@key":  "dbtype",
                                                                     "$":  "postgis"
                                                                 },
                                                                 {
                                                                     "@key":  "host",
                                                                     "$":  "${GEOSERVER_DATASTORE_HOST}"
                                                                 },
                                                                 {
                                                                     "@key":  "namespace",
                                                                     "$":  "${GEOSERVER_WORKSPACE_URI}"
                                                                 },
                                                                 {
                                                                     "@key":  "user",
                                                                     "$":  "${GEOSERVER_DATASTORE_USER}"
                                                                 }
                                                             ]
                                               }
                  }
}
